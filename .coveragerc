# Coverage configuration for the MobInspect test-coverage campaign.
# Strict real-execution: no mocks, no pragmas. Lines that only run with a
# device / Corellium / VirusTotal / Windows host stay uncovered on this
# host and close only on prod Linux + a device.
[run]
source = mobsf
branch = False
parallel = True
concurrency = multiprocessing,thread
omit =
    */migrations/*
    */tests/*
    */tests.py
    */test_*.py
    */tests_*.py
    */__pycache__/*
    mobsf/MobSF/wsgi.py
    mobsf/MobSF/asgi.py
    manage.py

[report]
show_missing = True
skip_covered = False
precision = 1
