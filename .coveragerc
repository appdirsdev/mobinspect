# Coverage configuration for MobInspect.
#
# Scope = "code we own and can execute on this host."
# Real-execution suite (no mocks). Coverage is measured over first-party code
# for every artifact format we support and can run here: Android (APK/XAPK/
# AAB/AAR/JAR/SO/source), iOS (IPA/dylib/.a/Mach-O/source), and the shared
# binary + report + RBAC + API layers.
#
# The `omit` entries below are code that CANNOT run to completion on this
# host without external hardware or services, so they are excluded from the
# denominator with a stated reason (rather than dragging the number down as
# permanently-red lines):
#   * DynamicAnalyzer/*        — needs a live Android/iOS device or emulator + Frida
#   * views/windows, install/windows — needs a Windows host (BinSkim/BinScope PE analysis)
#   * tools/androguard4/*      — vendored third-party APK/AXML parser (not our code)
#   * VirusTotal.py            — live VirusTotal cloud API (network + API key)
#   * __main__.py              — CLI entrypoint that starts a long-running server
#
# NOTE: omit lives in BOTH [run] (collection-time) and [report] (report-time)
# because dynamic/windows/vendored modules get imported during the run, so
# they must also be excluded when the report is generated.

[run]
source = mobinspect
branch = False
parallel = True
concurrency = multiprocessing,thread
omit =
    */migrations/*
    */tests/*
    */tests.py
    */test_*.py
    */tests_*.py
    */__pycache__/*
    */MobInspect/wsgi.py
    */MobInspect/asgi.py
    */manage.py
    */DynamicAnalyzer/*
    */StaticAnalyzer/views/windows/*
    */install/windows/*
    */StaticAnalyzer/tools/androguard4/*
    */MalwareAnalyzer/views/VirusTotal.py
    */mobinspect/__main__.py

[report]
show_missing = True
skip_covered = False
precision = 1
omit =
    */migrations/*
    */tests/*
    */tests.py
    */test_*.py
    */tests_*.py
    */__pycache__/*
    */MobInspect/wsgi.py
    */MobInspect/asgi.py
    */manage.py
    */DynamicAnalyzer/*
    */StaticAnalyzer/views/windows/*
    */install/windows/*
    */StaticAnalyzer/tools/androguard4/*
    */MalwareAnalyzer/views/VirusTotal.py
    */mobinspect/__main__.py
