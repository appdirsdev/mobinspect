# MobInspect PostgreSQL config — `source .env.postgres` before running the app.
# Settings switch to Postgres only when USER + PASSWORD + HOST are all set.
export POSTGRES_USER=mobsf
export POSTGRES_PASSWORD=mobsf
export POSTGRES_HOST=127.0.0.1
export POSTGRES_PORT=5432
export POSTGRES_DB=mobsf
# Ensure the postgres client libs / server bins are on PATH
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
