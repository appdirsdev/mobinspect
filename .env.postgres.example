# MobInspect PostgreSQL config template — copy to .env.postgres and set real
# credentials. The launchers `source .env.postgres` before running the app.
# PostgreSQL is REQUIRED — MobInspect never falls back to SQLite; startup
# fails loudly if USER/PASSWORD/HOST aren't set.
export POSTGRES_USER=mobsf
export POSTGRES_PASSWORD=change-me
export POSTGRES_HOST=127.0.0.1
export POSTGRES_PORT=5432
export POSTGRES_DB=mobinspect
# Ensure the postgres client libs / server bins are on PATH
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"

# ---- Background scanning ----------------------------------------------------
# ON by default (settings.py) — runs APK/XAPK/ZIP-source and IPA/ZIP-source
# analysis on the django-q worker instead of in-request, so a large upload
# doesn't pin the browser tab for the whole scan. The qcluster worker (started
# by start.sh / the mobinspect-worker service) must be running for queued
# scans to actually get processed. Set MOBINSPECT_ASYNC_ANALYSIS=0 to force
# the old in-request behavior.
export MOBINSPECT_ASYNC_WORKERS=1
