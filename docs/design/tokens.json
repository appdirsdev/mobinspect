{
  "$schema": "https://design-tokens.org/schema/v1",
  "_note": "Canonical export of design tokens. Mirror of tailwind.config.js. Do not hand-edit — regenerate via scripts/export-tokens.js.",
  "version": "0.1.0",
  "color": {
    "brand": {
      "50":  { "value": "#EFF6FF" },
      "100": { "value": "#DBEAFE" },
      "200": { "value": "#BFDBFE" },
      "300": { "value": "#93C5FD" },
      "400": { "value": "#3B82F6" },
      "500": { "value": "#2563EB" },
      "600": { "value": "#1D4ED8" },
      "700": { "value": "#1E40AF" },
      "800": { "value": "#1E3A8A" },
      "900": { "value": "#1E3A8A" },
      "950": { "value": "#172554" }
    },
    "severity": {
      "critical": { "light": "#DC2626", "dark": "#F87171", "use": "CVSS 9.0+, malware confirmed" },
      "high":     { "light": "#EA580C", "dark": "#FB923C", "use": "CVSS 7.0–8.9" },
      "medium":   { "light": "#D97706", "dark": "#FBBF24", "use": "CVSS 4.0–6.9" },
      "low":      { "light": "#2563EB", "dark": "#60A5FA", "use": "CVSS 0.1–3.9, info" },
      "passed":   { "light": "#16A34A", "dark": "#4ADE80", "use": "check passed" },
      "unknown":  { "light": "#64748B", "dark": "#94A3B8", "use": "undetermined / suppressed" }
    },
    "system": {
      "success":  { "light": "#16A34A", "dark": "#4ADE80" },
      "warning":  { "light": "#D97706", "dark": "#FBBF24" },
      "error":    { "light": "#DC2626", "dark": "#F87171" },
      "info":     { "light": "#2563EB", "dark": "#60A5FA" }
    },
    "surface": {
      "0": { "light": "#FFFFFF", "dark": "#0B0F1A", "use": "page" },
      "1": { "light": "#F8FAFC", "dark": "#111827", "use": "card" },
      "2": { "light": "#F1F5F9", "dark": "#1F2937", "use": "nested / hover row" },
      "3": { "light": "#E2E8F0", "dark": "#374151", "use": "sidebar / footer / code block" },
      "4": { "light": "#CBD5E1", "dark": "#4B5563", "use": "modal / drawer / popover" }
    },
    "border": {
      "subtle":  { "light": "#E2E8F0", "dark": "#1F2937" },
      "default": { "light": "#CBD5E1", "dark": "#374151" },
      "strong":  { "light": "#94A3B8", "dark": "#6B7280" }
    },
    "text": {
      "primary":   { "light": "#0F172A", "dark": "#F1F5F9" },
      "secondary": { "light": "#475569", "dark": "#94A3B8" },
      "tertiary":  { "light": "#94A3B8", "dark": "#64748B" },
      "inverse":   { "light": "#F8FAFC", "dark": "#0F172A" },
      "brand":     { "light": "#1D4ED8", "dark": "#3B82F6" }
    }
  },
  "typography": {
    "family": {
      "sans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'Cascadia Code', Menlo, monospace"
    },
    "scale": {
      "display": { "size": "48px", "lineHeight": 1.1,  "weight": 700 },
      "h1":      { "size": "30px", "lineHeight": 1.2,  "weight": 600 },
      "h2":      { "size": "24px", "lineHeight": 1.25, "weight": 600 },
      "h3":      { "size": "20px", "lineHeight": 1.3,  "weight": 600 },
      "h4":      { "size": "16px", "lineHeight": 1.4,  "weight": 600 },
      "body":    { "size": "14px", "lineHeight": 1.55, "weight": 400 },
      "small":   { "size": "13px", "lineHeight": 1.5,  "weight": 400 },
      "tiny":    { "size": "12px", "lineHeight": 1.4,  "weight": 500, "tracking": "0.05em", "uppercase": true },
      "mono":    { "size": "13px", "lineHeight": 1.5,  "weight": 400 }
    }
  },
  "spacing": {
    "_unit": "4px",
    "scale": [0, 2, 4, 8, 12, 16, 24, 32, 48, 64, 96, 128]
  },
  "radius": {
    "sm":   "4px",
    "md":   "6px",
    "lg":   "8px",
    "xl":   "12px",
    "2xl":  "16px",
    "full": "9999px"
  },
  "elevation": {
    "1":    "0 1px 2px rgb(0 0 0 / 0.05)",
    "2":    "0 4px 8px -2px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.04)",
    "3":    "0 12px 24px -8px rgb(0 0 0 / 0.12), 0 4px 8px -4px rgb(0 0 0 / 0.06)",
    "4":    "0 24px 48px -12px rgb(0 0 0 / 0.18)",
    "glow": "0 0 0 4px rgb(37 99 235 / 0.15)"
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320, "_unit": "ms" },
    "easing": {
      "out":   "cubic-bezier(0.16, 1, 0.3, 1)",
      "in":    "cubic-bezier(0.7, 0, 0.84, 0)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "patterns": {
      "pageTransition": { "duration": "base", "easing": "out", "transform": "fade + 4px slide-up" },
      "cardReveal":     { "duration": "slow", "easing": "out", "stagger": "50ms" },
      "hoverLift":      { "duration": "fast", "easing": "out", "transform": "translateY(-1px)" },
      "modalIn":        { "duration": "base", "easing": "out", "transform": "scale 0.95→1 + fade" },
      "toastIn":        { "duration": "base", "easing": "out", "transform": "slide-from-top-right + fade" },
      "chartMount":     { "duration": "slow", "easing": "inOut", "stagger": "80ms" }
    }
  },
  "layout": {
    "sidebar": { "expanded": "240px", "collapsed": "64px" },
    "topbar":  { "height": "56px" },
    "content": { "maxWidth": "1440px", "paddingX": { "desktop": "24px", "tablet": "16px" } },
    "grid":    { "cardGap": "16px" }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  }
}
