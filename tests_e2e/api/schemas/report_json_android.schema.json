{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MobInspect report_json response — Android family (apk/xapk/jar/aar/android_src/so)",
  "type": "object",
  "required": [
    "md5", "sha1", "sha256", "file_name", "size", "app_name",
    "package_name", "permissions", "manifest_analysis",
    "certificate_analysis", "code_analysis", "activities", "services",
    "receivers", "providers", "average_cvss"
  ],
  "properties": {
    "md5": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "sha1": {"type": "string"},
    "sha256": {"type": "string"},
    "file_name": {"type": "string"},
    "size": {"type": ["string", "integer"]},
    "app_name": {"type": "string"},
    "package_name": {"type": "string"},
    "permissions": {"type": "object"},
    "manifest_analysis": {"type": "object"},
    "certificate_analysis": {"type": "object"},
    "code_analysis": {"type": "object"},
    "activities": {"type": "array"},
    "services": {"type": "array"},
    "receivers": {"type": "array"},
    "providers": {"type": "array"},
    "average_cvss": {"type": ["number", "null"]}
  }
}
